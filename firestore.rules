rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /phoneTickets/{ticketId} {
      allow read, write: if true;
    }
    match /smsMessages/{messageId} {
      allow read, write: if true;
    }
    match /mailTickets/{ticketId} {
      allow read, write: if true;
    }
    match /mailMessages/{messageId} {
      allow read, write: if true;
    }
    match /paymentReceipts/{receiptId} {
      allow read, write: if true;
    }
  }
}

